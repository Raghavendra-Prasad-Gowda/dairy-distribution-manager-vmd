{
  "name": "vmd-ui-automation",
  "private": true,
  "version": "1.0.0",
  "description": "Black-box UI tests (Playwright + TypeScript) against a deployed Vikas Milk Dairy environment",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
