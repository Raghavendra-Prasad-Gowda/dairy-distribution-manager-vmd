DATABASE_URL="postgresql://USER:PASSWORD@db.supabase.co:5432/postgres?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@db.supabase.co:5432/postgres"
JWT_SECRET=your_random_secret_minimum_32_chars_long
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
ADMIN_PASSWORD=your_initial_login_password
# 4–12 chars. REQUIRED in production — the app refuses to boot without it (no default).
EDIT_PIN=choose_a_secret_pin
NODE_ENV=development

# Optional — when set, prisma/seed.js creates/syncs a superadmin account on
# every boot. When unset, seeding is skipped entirely (not an error).
# SUPERADMIN_USERNAME=admin
# SUPERADMIN_PASSWORD=choose_a_strong_password
