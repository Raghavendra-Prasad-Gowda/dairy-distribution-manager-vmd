DATABASE_URL="postgresql://USER:PASSWORD@db.supabase.co:5432/postgres?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@db.supabase.co:5432/postgres"
# Production only. PEM contents of the managed Postgres provider's CA
# certificate (Aiven Console → service → Overview → "CA certificate").
# Pins TLS verification to the real CA. If unset in production, the app
# falls back to unverified TLS (encrypted, no server-identity check) and
# logs a warning at boot — see server/utils/dbUrl.js.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
JWT_SECRET=your_random_secret_minimum_32_chars_long
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
# Still required in production by config/env.js, but no longer read by any code (legacy).
ADMIN_PASSWORD=your_initial_login_password
# 4–12 chars. Seeds the edit PIN and P&L PIN on the FIRST boot only (falls back to 123456 if unset —
# set it). Afterwards change PINs in the superadmin UI; they are stored hashed in the AppSettings table.
EDIT_PIN=choose_a_secret_pin
NODE_ENV=development

# Optional — when set, prisma/seed.js creates/syncs a superadmin account on
# every boot. When unset, seeding is skipped entirely (not an error).
# SUPERADMIN_USERNAME=admin
# SUPERADMIN_PASSWORD=choose_a_strong_password

# Optional — login attempts allowed per IP per hour (default 20). Raise ONLY on a test
# environment that runs many logins from one address (CI); keep the default in production.
# LOGIN_RATE_LIMIT_MAX=20

# Optional — requests per IP per minute on the bulk-write routes (default 30). Raise ONLY on a test
# environment that drives many of these routes from one address (UI automation); keep the default in production.
# BULK_WRITE_RATE_LIMIT_MAX=30
