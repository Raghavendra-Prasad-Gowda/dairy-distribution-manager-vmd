{
  "name": "dairy-distribution-manager-server",
  "version": "1.0.0",
  "description": "Dairy Distribution Manager — Backend API",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node index.js",
    "test": "playwright test",
    "test:coverage": "c8 playwright test",
    "lint": "eslint .",
    "lint:tz": "node scripts/check-timezone-safety.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run lint:tz && npm test",
    "build": "npx prisma generate && node scripts/write-version.js",
    "deploy": "npx prisma migrate deploy",
    "start:prod": "node index.js",
    "postinstall": "npx prisma generate",
    "seed": "node prisma/seed.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "otplib": "^13.5.0",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "qrcode": "^1.5.4",
    "winston": "^3.17.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "c8": "^12.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.6"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.1",
    "fast-uri": "^3.1.7",
    "qs": "^6.16.0",
    "mysql2": "^3.24.4",
    "minimatch": "^11.0.3",
    "glob": "^14.0.3"
  }
}
