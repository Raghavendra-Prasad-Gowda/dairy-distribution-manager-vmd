{
  "name": "dairy-distribution-manager-server",
  "version": "1.0.0",
  "description": "Dairy Distribution Manager — Backend API",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node index.js",
    "test": "playwright test",
    "test:coverage": "c8 playwright test",
    "lint": "eslint .",
    "lint:tz": "node scripts/check-timezone-safety.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run lint:tz && npm test",
    "build": "npx prisma generate",
    "deploy": "npx prisma migrate deploy",
    "start:prod": "node index.js",
    "postinstall": "npx prisma generate",
    "seed": "node prisma/seed.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.16.3",
    "prisma": "^5.22.0",
    "winston": "^3.17.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "c8": "^12.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "prettier": "^3.9.6"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
