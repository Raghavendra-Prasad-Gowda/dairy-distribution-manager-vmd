generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Brands ───────────────────────────────────────────────────────────────────

model Brand {
  id              Int      @id @default(autoincrement())
  name            String   @unique
  displayOrder      Int      @default(0) @map("display_order")
  depositEnabled    Boolean  @default(false) @map("deposit_enabled")
  depositPerLitre   Decimal  @default(0) @db.Decimal(10, 4) @map("deposit_per_litre")
  depositCalcMethod String   @default("litre") @map("deposit_calc_method")
  createdAt         DateTime @default(now()) @map("created_at")

  products      Product[]
  categories    Category[]
  routes        Route[]
  stockReceipts StockReceipt[]
  dairyBalances DairyBalance[]
  dairyPayments DairyPayment[]

  @@map("brands")
}

// ─── Products ─────────────────────────────────────────────────────────────────

model Product {
  id          Int      @id @default(autoincrement())
  brandId     Int      @map("brand_id")
  name        String
  category    String?
  mlPerCrate          Int?     @map("ml_per_crate")
  unitType            String   @default("piece") @map("unit_type")
  unitSize            Int?     @map("unit_size")
  containerType       String?  @map("container_type")
  unitsPerContainer   Int?     @map("units_per_container")
  costPrice           Decimal  @default(0) @db.Decimal(10, 4) @map("cost_price")
  sellingPrice        Decimal  @default(0) @db.Decimal(10, 4) @map("selling_price")
  isActive            Boolean  @default(true) @map("is_active")
  showInStockReceipt  Boolean  @default(true) @map("show_in_stock_receipt")
  depositEnabled      Boolean  @default(false) @map("deposit_enabled")
  displayOrder        Int      @default(0) @map("display_order")
  createdAt           DateTime @default(now()) @map("created_at")

  brand                Brand                @relation(fields: [brandId], references: [id], onDelete: Cascade)
  stockReceipts        StockReceipt[]
  salespersonPrices    SalespersonPrice[]
  salespersonProducts  SalespersonProduct[]
  dispatchItems        StockDispatchItem[]
  costPrices           ProductCostPrice[]
  sellingPrices        ProductSellingPrice[]

  @@unique([brandId, name])
  @@map("products")
}

// ─── Product Cost Price History ───────────────────────────────────────────────

model ProductCostPrice {
  id            Int      @id @default(autoincrement())
  productId     Int      @map("product_id")
  costPrice     Decimal  @db.Decimal(10, 4) @map("cost_price")
  effectiveFrom DateTime @db.Date @map("effective_from")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, effectiveFrom])
  @@map("product_cost_prices")
}

// ─── Product Selling Price History ───────────────────────────────────────────

model ProductSellingPrice {
  id            Int      @id @default(autoincrement())
  productId     Int      @map("product_id")
  sellingPrice  Decimal  @db.Decimal(10, 4) @map("selling_price")
  effectiveFrom DateTime @db.Date @map("effective_from")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, effectiveFrom])
  @@map("product_selling_prices")
}

// ─── Categories ───────────────────────────────────────────────────────────────

model Category {
  id             Int      @id @default(autoincrement())
  brandId        Int      @map("brand_id")
  name           String
  displayOrder   Int      @default(0) @map("display_order")
  depositEnabled Boolean  @default(false) @map("deposit_enabled")
  createdAt      DateTime @default(now()) @map("created_at")

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([brandId, name])
  @@map("categories")
}

// ─── Routes ───────────────────────────────────────────────────────────────────

model Route {
  id           Int      @id @default(autoincrement())
  brandId      Int      @map("brand_id")
  routeNumber  String   @map("route_number")
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([brandId, routeNumber])
  @@map("routes")
}

// ─── Stock Receipts ───────────────────────────────────────────────────────────

model StockReceipt {
  id          Int      @id @default(autoincrement())
  brandId     Int      @map("brand_id")
  productId   Int      @map("product_id")
  routeId     Int      @default(0) @map("route_id")  // 0 = no route (Jersey/Gowardhan); actual route ID for Nandini
  receiptDate DateTime @db.Date @map("receipt_date")
  quantity    Decimal  @default(0) @db.Decimal(10, 2)
  unitPrice   Decimal  @db.Decimal(10, 4) @map("unit_price")
  createdAt   DateTime @default(now()) @map("created_at")

  brand   Brand   @relation(fields: [brandId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([productId, receiptDate, routeId])
  @@index([brandId, receiptDate])
  @@map("stock_receipts")
}

// ─── Dairy Balance ────────────────────────────────────────────────────────────

model DairyBalance {
  id             Int      @id @default(autoincrement())
  brandId        Int      @map("brand_id")
  balanceDate    DateTime @db.Date @map("balance_date")
  openingBalance Decimal  @default(0) @db.Decimal(10, 2) @map("opening_balance")
  stockValue     Decimal  @default(0) @db.Decimal(10, 2) @map("stock_value")
  depositValue   Decimal  @default(0) @db.Decimal(10, 2) @map("deposit_value")
  amountPaid     Decimal  @default(0) @db.Decimal(10, 2) @map("amount_paid")
  closingBalance Decimal  @default(0) @db.Decimal(10, 2) @map("closing_balance")
  createdAt      DateTime @default(now()) @map("created_at")

  brand Brand @relation(fields: [brandId], references: [id])

  @@unique([brandId, balanceDate])
  @@map("dairy_balances")
}

// ─── Dairy Payments ───────────────────────────────────────────────────────────

model DairyPayment {
  id          Int      @id @default(autoincrement())
  brandId     Int      @map("brand_id")
  paymentDate DateTime @db.Date @map("payment_date")
  amount      Decimal  @db.Decimal(10, 2)
  paymentMode String?  @map("payment_mode")
  reference   String?
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  brand Brand @relation(fields: [brandId], references: [id])

  @@index([brandId, paymentDate])
  @@map("dairy_payments")
}

// ─── Salespeople ──────────────────────────────────────────────────────────────

model Salesperson {
  id           Int      @id @default(autoincrement())
  name         String
  phone        String?
  route        String?
  username     String?  @unique
  passwordHash String?  @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  prices     SalespersonPrice[]
  products   SalespersonProduct[]
  dispatches StockDispatch[]
  balances   SalespersonBalance[]
  payments   SalespersonPayment[]

  @@map("salespeople")
}

// ─── Salesperson Prices ───────────────────────────────────────────────────────

model SalespersonPrice {
  id            Int      @id @default(autoincrement())
  salespersonId Int      @map("salesperson_id")
  productId     Int      @map("product_id")
  sellingPrice  Decimal  @db.Decimal(10, 4) @map("selling_price")
  effectiveFrom DateTime @db.Date @default(now()) @map("effective_from")
  createdAt     DateTime @default(now()) @map("created_at")

  salesperson Salesperson @relation(fields: [salespersonId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([salespersonId, productId, effectiveFrom])
  @@map("salesperson_prices")
}

// ─── Salesperson Product Visibility ──────────────────────────────────────────

model SalespersonProduct {
  id            Int      @id @default(autoincrement())
  salespersonId Int      @map("salesperson_id")
  productId     Int      @map("product_id")
  isEnabled     Boolean  @default(false) @map("is_enabled")
  createdAt     DateTime @default(now()) @map("created_at")

  salesperson Salesperson @relation(fields: [salespersonId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([salespersonId, productId])
  @@map("salesperson_products")
}

// ─── Stock Dispatches ─────────────────────────────────────────────────────────

model StockDispatch {
  id              Int      @id @default(autoincrement())
  salespersonId   Int      @map("salesperson_id")
  dispatchDate    DateTime @db.Date @map("dispatch_date")
  totalAmount     Decimal  @default(0) @db.Decimal(10, 2) @map("total_amount")
  notes           String?
  isSubmitted     Boolean  @default(false) @map("is_submitted")
  isAdminUnlocked Boolean  @default(false) @map("is_admin_unlocked")
  createdAt       DateTime @default(now()) @map("created_at")

  salesperson Salesperson         @relation(fields: [salespersonId], references: [id])
  items       StockDispatchItem[]

  @@unique([salespersonId, dispatchDate])
  @@map("stock_dispatches")
}

model StockDispatchItem {
  id          Int     @id @default(autoincrement())
  dispatchId  Int     @map("dispatch_id")
  productId   Int     @map("product_id")
  quantity    Decimal @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(10, 4) @map("unit_price")
  totalAmount Decimal @db.Decimal(10, 2) @map("total_amount")

  dispatch StockDispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  product  Product       @relation(fields: [productId], references: [id])

  @@index([dispatchId])
  @@index([productId])
  @@map("stock_dispatch_items")
}

// ─── Salesperson Balance ──────────────────────────────────────────────────────

model SalespersonBalance {
  id             Int      @id @default(autoincrement())
  salespersonId  Int      @map("salesperson_id")
  balanceDate    DateTime @db.Date @map("balance_date")
  openingBalance Decimal  @default(0) @db.Decimal(10, 2) @map("opening_balance")
  stockGiven     Decimal  @default(0) @db.Decimal(10, 2) @map("stock_given")
  amountPaid     Decimal  @default(0) @db.Decimal(10, 2) @map("amount_paid")
  closingBalance Decimal  @default(0) @db.Decimal(10, 2) @map("closing_balance")
  createdAt      DateTime @default(now()) @map("created_at")

  salesperson Salesperson @relation(fields: [salespersonId], references: [id])

  @@unique([salespersonId, balanceDate])
  @@map("salesperson_balances")
}

// ─── Salesperson Payments ─────────────────────────────────────────────────────

model SalespersonPayment {
  id            Int      @id @default(autoincrement())
  salespersonId Int      @map("salesperson_id")
  paymentDate   DateTime @db.Date @map("payment_date")
  amount        Decimal  @db.Decimal(10, 2)
  paymentMode   String?  @map("payment_mode")
  reference     String?
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")

  salesperson Salesperson @relation(fields: [salespersonId], references: [id])

  @@index([salespersonId, paymentDate])
  @@map("salesperson_payments")
}

// ─── App Settings ─────────────────────────────────────────────────────────────

model AppSettings {
  id           Int      @id @default(autoincrement())
  businessName String   @default("Vikas Milk Dairy") @map("business_name")
  username     String   @default("admin")
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}
